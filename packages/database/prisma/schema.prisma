  bucket       DateTime @db.Timestamptz(6)
  market       String   @db.VarChar(20)
  open         Float?
  high         Float?
  low          Float?
  close        Float?
  currencyCode String?  @map("currency_code") @db.VarChar(10)

  @@unique([bucket, market])
  @@map("klines_3s")
}
