generator client {
  provider = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TimescaleDB hypertable. Created via raw SQL in seed-db.ts (create_hypertable()
// is a Timescale extension function `prisma migrate` cannot express), so this
// model is for typed queries only — do not run `prisma migrate` against it.
model TataPrice {
  id           BigInt   @id @default(autoincrement())
  time         DateTime @db.Timestamptz(6)
  price        Float?
  qty          Decimal? @db.Decimal(18, 2)
  currencyCode String?  @map("currency_code") @db.VarChar(10)
  side         String   @db.VarChar(4)

  @@map("tata_prices")
}

// Continuous-aggregate materialized views, created/refreshed via raw SQL
// (seed-db.ts / cron.ts). Mapped here as read-only Prisma views.
view Kline1m {
  bucket       DateTime @db.Timestamptz(6)
  open         Float?
  high         Float?
  low          Float?
  close        Float?
  currencyCode String?  @map("currency_code") @db.VarChar(10)

  @@map("klines_1m")
}

view Kline1h {
  bucket       DateTime @db.Timestamptz(6)
  open         Float?
  high         Float?
  low          Float?
  close        Float?
  currencyCode String?  @map("currency_code") @db.VarChar(10)

  @@map("klines_1h")
}

view Kline1w {
  bucket       DateTime @db.Timestamptz(6)
  open         Float?
  high         Float?
  low          Float?
  close        Float?
  currencyCode String?  @map("currency_code") @db.VarChar(10)

  @@map("klines_1w")
}
