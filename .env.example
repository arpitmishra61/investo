# Copy to .env on the Oracle box and fill in real values.
# docker-compose reads this file via env_file.

# --- Neon (managed Postgres / TimescaleDB) ---
# Use your existing Neon connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# --- Redis (self-hosted in the redis container) ---
# Host = compose service name — all containers reach it as "redis".
REDIS_URL=redis://redis:6379

# --- App config ---
API_URL=http://api:8000
PORT=8000

# x-admin-key required for POST /api/v1/admin/reset — also used by the
# daily rotate-trades cron to reset engine orderbooks/balances.
ADMIN_KEY=change-me-in-prod

# Signs/verifies user auth JWTs (apps/api/src/middleware/auth.ts). The mm
# service also signs its own service-account token with this same secret to
# call POST /api/v1/order, so api and mm must share this value — in prod both
# read it from this one file via env_file, so setting it once here is enough.
JWT_SECRET=change-me-in-prod
