# Copy to .env on the Oracle box and fill in real values.
# docker-compose reads this file (env_file + ${...} interpolation).

# --- Postgres / TimescaleDB (self-hosted in the timescaledb container) ---
POSTGRES_USER=investo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=investo

# Consumed by @repo/database, apps/db, apps/mm. Host = compose service name.
DATABASE_URL=postgresql://investo:change-me-strong-password@timescaledb:5432/investo

# --- Redis (self-hosted in the redis container) ---
# Host = compose service name; api/engine/ws now read this too.
REDIS_URL=redis://redis:6379

# --- App config ---
API_URL=http://api:8000
PORT=8000
